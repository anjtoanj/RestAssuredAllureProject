<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="RestAssured API Test Suite" parallel="methods" thread-count="4">

    <listeners>
        <listener class-name="com.pets.listeners.AllureListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="API Tests">
        <packages>
            <package name="com.pets.tests.accountApiV1.*"/>
            <package name="com.pets.tests.customerApiV1.*"/>
            <package name="com.pets.tests.cardsApiV1.*"/>
            <package name="com.pets.tests.paymentsApiV1.*"/>
        </packages>
    </test>

</suite>
